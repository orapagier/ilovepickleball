# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It holds no secrets — only the variable names and
# what each is for — so a fresh clone can see what needs filling in.
# The negation must come after BOTH .env* rules in this file to take effect.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database dumps — real customer data, never commit one
*.sql
*.sql.gz
!prisma/migrations/**/*.sql

/src/generated/prisma

# agent tooling artifacts (not part of the app)
.agents/
.claude/
skills-lock.json


.vercel
.env*
!.env.example
