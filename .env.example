# I Love Pickleball Booking — environment template.
#
# Copy to .env.local and fill in. Next.js loads .env.local automatically for
# `next dev` and `next build`; .env.local is gitignored, this template is not.
# Contains NO secrets — only variable names and what each one is for.
#
#     cp .env.example .env.local
#     # or let setup-booking.sh do it and generate NEXTAUTH_SECRET for you

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL on Neon — nothing runs locally.
#   Neon console:  https://console.neon.tech  ->  your project  ->  Connect
#   Vercel:        https://vercel.com/dashboard -> project -> Settings ->
#                  Environment Variables   (or: vercel env pull .env.local)
#
# Use the DIRECT (unpooled) string — the host WITHOUT "-pooler" in it.
# src/lib/prisma.ts runs its own pg Pool (max 10, keepAlive), so Neon's
# PgBouncer on top of that is redundant; `prisma migrate` and `pg_dump` need a
# direct connection anyway. Keeping sslmode=require in the URL is fine: the app
# strips it and asks for verified TLS through the pool config instead.
DATABASE_URL=

# ── Auth (required) ──────────────────────────────────────────────────────────
# next-auth v5. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Google sign-in for the app itself.
#   https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID
#   Authorised redirect URI (local): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated addresses that get the admin role.
ADMIN_EMAILS=

# ── Agent API (optional) ─────────────────────────────────────────────────────
# Shared secret for the agent endpoints — see docs/agent-api.md.
AGENT_API_KEY=

# ── Google Drive backups (optional) ──────────────────────────────────────────
# Used by `npm run drive:auth` and `npm run backup:upload`. Full walkthrough in
# docs/backups-and-calendar.md. In CI these live in GitHub Actions secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
BACKUP_FOLDER_NAME=Smash Zone DB Backups
BACKUP_RETENTION_DAYS=30
OAUTH_PORT=53682

# ── Google Calendar service account (optional) ───────────────────────────────
# See docs/backups-and-calendar.md. GOOGLE_SA_PRIVATE_KEY: the JSON key's
# private_key with newlines as literal \n, wrapped in double quotes.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
